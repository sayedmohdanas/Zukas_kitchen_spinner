rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read-only access for campaign status & configuration
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if false; // Admin SDK / Console only
    }

    // Public read and write access for prizes (so dashboard can edit them)
    // NOTE: In production, this should be secured with authentication
    match /prizes/{prizeId} {
      allow read, write: if true;
    }

    // Public direct reads and writes to spins collection are COMPLETELY BLOCKED!
    // All spin transactions, eligibility checks, prize selection, and coupon generation
    // must strictly occur through the trusted Cloud Function (spinWheel).
    match /spins/{spinId} {
      allow read, write: if false;
    }

    // Public read and write for villages list
    match /villages/{villageId} {
      allow read, write: if true;
    }

    // Public read, create, update, delete for customer reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
